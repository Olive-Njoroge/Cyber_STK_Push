# --- PayHero credentials -------------------------------------------------
# From your PayHero dashboard: API Keys -> Add new API Key.
# The dashboard shows a ready-made Basic token; it is base64(username:password).
PAYHERO_API_USERNAME=your_api_username
PAYHERO_API_PASSWORD=your_api_password

# Optional. If your dashboard gave you the Basic token directly, paste it here
# and it is used verbatim instead of base64(username:password).
# PAYHERO_BASIC_AUTH_TOKEN=

# Payment Channels -> My Payment Channels. Numeric.
PAYHERO_CHANNEL_ID=0000

# --- Callback ------------------------------------------------------------
# Must be reachable from the public internet, full path included.
#   Deployed: https://<your-service>.onrender.com/api/payments/callback
#   Local:    run `ngrok http 5000` and paste the https forwarding URL
CALLBACK_URL=https://your-service.onrender.com/api/payments/callback

# Browser origins allowed to call this API, comma separated. Leave blank to
# allow any origin (fine locally). In production set it to the Vercel URL.
# CORS_ORIGIN=https://your-app.vercel.app

# --- Infrastructure ------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/cyber_stk
PORT=5000

# Background sweep that verifies old PENDING rows against PayHero.
# true | false
ENABLE_STALE_SWEEP=false
