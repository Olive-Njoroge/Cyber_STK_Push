# Where the Express API lives.
#
# Leave BLANK for local development - the Vite dev server proxies /api to
# http://localhost:5000 (override that target with VITE_API_TARGET).
#
# On Vercel, set this to the full Render URL, no trailing slash:
#   VITE_API_BASE_URL=https://your-service.onrender.com
VITE_API_BASE_URL=

# Dev-server proxy target. Only matters when VITE_API_BASE_URL is blank.
VITE_API_TARGET=http://localhost:5000
